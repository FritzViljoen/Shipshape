# frozen_string_literal: true

require "test_helper"

# Generated by shipshape. This file is yours now.
#
# **`one-operation-one-class`, asked of the loaded application.** The cops read source and
# answer in a second; this boots the app and answers exactly. Both are wanted — the cops tell
# you in the editor, this one tells you the truth.
#
# What it catches that no cop can: a module included through a variable or a constant lookup,
# a method made by `define_method` or `class_eval`, a concern that includes another concern,
# and anything a gem mixed into one of your operations.
class OperationsExposeNothingTest < ActiveSupport::TestCase
  DOORS = [Command, Query, Workflow, IoQuery, IoCommand, LegacyQuery, LegacyCommand].freeze

  # The two an operation may answer. Which it implements decides whether it is checked, so
  # neither is an addition.
  ENTRY = %i[call anonymous_call].freeze

  def test_no_operation_exposes_anything_its_base_class_did_not
    exposed = operations.filter_map do |operation|
      extra = public_additions(operation)

      "#{operation}: #{extra.sort.join(', ')}" unless extra.empty?
    end

    assert_equal [], exposed, <<~WHY
      An operation answers `call` and nothing else. Each name above is public on that
      operation and is not on its base class, so it arrived from the class itself or from
      something it mixes in.

      Nearly always the fix is `private`. Where a caller really needs the answer, it is a
      query with its own name and its own door — not a second entrance to this one.
    WHY
  end

  private

  # Every public method this operation has that its base class does not — instance and class,
  # mixins included, however they arrived. It works because the base classes are POROs in this
  # repository with a known surface, so everything above that line was added here.
  #
  # **Measured from the door, not from `superclass`.** They are the same while
  # `an-operation-is-a-leaf` holds, and if it ever does not, measuring from `superclass` would
  # compare an operation against another operation and report nothing.
  def public_additions(operation)
    door = DOORS.find { |candidate| operation < candidate }
    return [] if door.nil?

    (operation.public_instance_methods - door.public_instance_methods - ENTRY) +
      (operation.methods - door.methods)
  end

  # Anonymous classes are somebody's test fixture, not an operation, and they have no name to
  # report. Sorted so the failure reads the same way twice.
  def operations
    Rails.application.eager_load!

    DOORS.flat_map(&:descendants).uniq.select(&:name).sort_by(&:name)
  end
end
