# frozen_string_literal: true

# `rails shipshape:routes` — every route with the permissions needed to reach it.
namespace :shipshape do
  desc "Every route with the permissions needed to reach it"
  task routes: :environment do
    Rails.application.eager_load!

    rows = CallGraph.routes.sort_by { |row| [row[:endpoint], row[:verb]] }

    if rows.empty?
      puts "No route resolved to a controller class. Nothing here can say what any of them demand."
      next
    end

    headings = %w[Verb URI\ Pattern Controller#Action Permissions]
    table = rows.map do |row|
      [row[:verb], row[:path], row[:endpoint],
       row[:permissions].any? ? row[:permissions].join(", ") : "—"]
    end

    widths = headings.each_index.map do |column|
      ([headings[column]] + table.map { |cells| cells[column] }).map(&:length).max
    end

    puts headings.each_with_index.map { |cell, i| cell.ljust(widths[i]) }.join("  ").rstrip
    table.each do |cells|
      puts cells.each_with_index.map { |cell, i| cell.ljust(widths[i]) }.join("  ").rstrip
    end

    unguarded = rows.count { |row| row[:permissions].empty? }
    puts
    puts "#{rows.length} route(s); #{unguarded} demand nothing."
    puts "A route demanding nothing reaches no governed operation, or only anonymous ones." if unguarded.positive?
  end
end
