#
# **A record does not travel.** Whatever holds one can lazily load an association, write
# through it, and reopen a query where nobody is looking for one.
#
# The call graph refuses a record being *named* out of place but can say nothing about one
# arriving as an argument — `ProfileShape.new(person: PersonRecord.find(1))` names no record at
# the shape. So the question is asked of the object instead, where the answer is exact.
#
# Two callers: `TypedArguments#typed` asks at the argument, where the message can name the
# keyword; the `new` hook below sweeps whatever the object ended up holding, which is the
# backstop the first cannot be.
#
# `defined?` throughout, because these are POROs loaded in suites that never booted Rails.
module HoldsNoRecords
  def self.record?(value)
    (defined?(::ActiveRecord::Base) && value.is_a?(::ActiveRecord::Base)) ||
      (defined?(::ActiveRecord::Relation) && value.is_a?(::ActiveRecord::Relation))
  end

  # A collection holding one is holding one. Checked to the element because
  # `lines: person.orders` is the shape this arrives in far more often than a bare record.
  def self.anywhere_in?(value)
    case value
    when Array then value.any? { |element| anywhere_in?(element) }
    when Hash then value.any? { |key, element| anywhere_in?(key) || anywhere_in?(element) }
    else record?(value)
    end
  end

  def new(*arguments, **keywords, &block)
    object = super
    refuse_records(object)
    object
  end

  private

  def refuse_records(object)
    object.instance_variables.each do |name|
      value = object.instance_variable_get(name)
      next unless HoldsNoRecords.anywhere_in?(value)

      raise TypeError, "#{object.class}##{name} holds #{value.class}. This is the " \
                       "presentation layer — hand it the fields it needs, or a shape built " \
                       "from them, never the record."
    end
  end
