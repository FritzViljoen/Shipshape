# frozen_string_literal: true

# Asked of the object, because an argument names no constant for a cop to see.
module HoldsNoRecords
  def self.record?(value)
    (defined?(::ActiveRecord::Base) && value.is_a?(::ActiveRecord::Base)) ||
      (defined?(::ActiveRecord::Relation) && value.is_a?(::ActiveRecord::Relation))
  end

  def self.anywhere_in?(value)
    case value
    when Array then value.any? { |element| anywhere_in?(element) }
    when Hash then value.any? { |key, element| anywhere_in?(key) || anywhere_in?(element) }
    else record?(value)
    end
  end

  def new(*arguments, **keywords, &block)
    object = super
    refuse_records(object)
    object
  end

  private

  def refuse_records(object)
    object.instance_variables.each do |name|
      value = object.instance_variable_get(name)
      next unless HoldsNoRecords.anywhere_in?(value)

      raise TypeError, "#{object.class}##{name} holds #{value.class}. This is the " \
                       "presentation layer — hand it the fields it needs, or a shape built " \
                       "from them, never the record."
    end
  end
end
