#
# **A shape, made small enough to put on a queue and built back afterwards.**
#
# `call_later` was free for every other argument: *a record is not an argument*, so a
# command's inputs are already ids and values, which is exactly what ActiveJob serialises. A
# `Shape` is the exception — `command → shape` is in the matrix, so `typed(money, Money)` is an
# ordinary thing for a command to take, and ActiveJob refuses an arbitrary object.
#
# **Packed here rather than registered with ActiveJob.** An `ActiveJob::Serializers`
# registration needs an initializer to run at boot, which is a file in `config/` and a boot
# order to get wrong; this needs neither. The door packs on the way out and the job unpacks on
# the way in, and the whole mechanism is two methods somebody can read.
#
# **It works because a shape is a value with declared fields.** Its state is its instance
# variables, it holds no record — `HoldsNoRecords` refuses one at construction — and its
# initializer takes those fields as named keywords. So the round trip is exact, and a shape
# that would not survive it could not have been built in the first place.
module ShapePacking
  # Deliberately unlikely to collide with a Hash an operation actually takes.
  MARKER = "__shape__"

  def self.pack(value)
    case value
    when Shape then { MARKER => value.class.name, "fields" => pack(fields(value)) }
    when Array then value.map { |element| pack(element) }
    when Hash then value.to_h { |key, element| [key.to_s, pack(element)] }
    else value
    end
  end

  def self.unpack(value)
    case value
    when Array then value.map { |element| unpack(element) }
    when Hash then value.key?(MARKER) ? build(value) : value.to_h { |k, v| [k.to_sym, unpack(v)] }
    else value
    end
  end

  def self.build(packed)
    Object.const_get(packed.fetch(MARKER)).new(**unpack(packed.fetch("fields")))
  end

  # A shape's state is its instance variables — the same thing `==` and `hash` are built on,
  # so anything that survives this survives comparison too.
  def self.fields(shape)
    shape.instance_variables.to_h { |name| [name.to_s.delete("@"), shape.instance_variable_get(name)] }
  end

  private_class_method :build, :fields
end
