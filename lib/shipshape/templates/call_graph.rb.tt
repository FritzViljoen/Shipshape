# frozen_string_literal: true

# **Which operations exist, which of them call which, and what each endpoint demands.**
#
# An operation demands its own permission and every permission it reaches, so a command that
# calls a query demands that query too. This reads the same source the base classes read, at
# boot, and answers the questions a permissions screen asks.
#
#   CallGraph.edges(Command, Query)
#   # => { "CancelBooking" => ["FindBooking"], "FindBooking" => [] }
#
#   CallGraph.grantable(Command, Query)   # => [:CancelBooking, :FindBooking]
#   CallGraph.unchecked(Command, Query)   # => [:LoadTenant]
#
# **`grantable` is every permission an actor can be asked for.** Nothing is left off for being
# reached from inside another operation: aggregation means the actor holds it either way, and a
# screen that hid it would produce a refusal nobody could explain.
#
# **`unchecked` is the operations that declared they need none.** A query used only to serve the
# commands that call it implements `anonymous_call` instead of `call` — the same declaration a
# login uses — and then it is never granted and never aggregated. That is how a read says "I am
# part of my caller's act", and it is a property of the class rather than of the call site, so
# `grep -rn "def anonymous_call"` is the audit.
#
# **Per endpoint is the question actually being asked**, because an actor does not hold a
# permission in the abstract; they hold it in order to reach something:
#
#   CallGraph.routes
#   # => [{ verb: "POST", path: "/bookings/:id/cancel",
#   #       endpoint: "BookingsController#cancel", permissions: [:CancelBooking, :FindBooking] }]
#
# **The keys are class names, and nothing here holds a label.** A screen wants "Cancel a
# booking", and that is content — translated, edited, versioned — so it belongs in a row keyed
# by the name rather than in a constant.
class CallGraph
  FORMAT = /\(\.:format\)\z/.freeze

  class << self
    # `{ "CancelBooking" => ["FindBooking"] }`, for every operation of the given doors.
    def edges(*doors)
      operations(*doors).each_with_object({}) do |operation, found|
        found[operation.name] = Calls.in(operation, entry_point(operation)).map(&:name).uniq.sort
      end
    end

    # Every permission an actor can be asked for. An operation aggregates what it reaches, so
    # reaching one from inside another does not excuse the actor from holding it.
    def grantable(*doors)
      permissions_of(operations(*doors)).uniq.sort
    end

    # **What each endpoint demands.** Empty when there is no Rails to ask, which is a fact about
    # this process rather than about the application, so it says nothing rather than guessing.
    def routes(application = rails_application)
      return [] unless application

      application.routes.routes.filter_map { |route| endpoint(route) }
    end

    # Declared to need no grant, by implementing `anonymous_call` rather than `call`. A screen
    # must not offer these — not because they are unreachable, but because holding one would
    # mean nothing.
    def unchecked(*doors)
      operations(*doors).select(&:anonymous?).map(&:permission).uniq.sort
    end

    # **Anonymity that is not closed downward.** An anonymous operation runs unchecked, so a
    # guarded one below it runs unchecked too — the loophole reopened one level down.
    # `Shipshape/AnonymityIsClosedDownward` fails the build on this; here it is readable at
    # runtime, per operation, so one bad declaration is a row rather than a dead catalogue.
    def leaks(*doors)
      operations(*doors).select(&:anonymous?).each_with_object({}) do |operation, found|
        guarded = operation.send(:reaches).reject(&:anonymous?)
        found[operation.name] = guarded.map(&:name).sort if guarded.any?
      end
    end

    private

    # A route names its controller and action as strings. The controller may not be loadable,
    # and an action may be inherited or handled by something that is not a class here.
    def endpoint(route)
      controller = controller_for(route)
      action = route.defaults[:action]
      return nil unless controller && action

      demanded = permissions_of(Calls.in(controller, action.to_sym))
      return nil if demanded.empty?

      { verb: route.verb.to_s, path: route.path.spec.to_s.sub(FORMAT, ""),
        endpoint: "#{controller.name}##{action}", permissions: demanded.uniq.sort }
    end

    def controller_for(route)
      name = route.defaults[:controller]
      return nil unless name

      found = Object.const_get(camelize("#{name}_controller"))
      found.is_a?(Class) ? found : nil
    rescue ::NameError
      nil
    end

    # **ActiveSupport's, never a hand-rolled one.** An application declaring
    # `inflect.acronym "API"` names its controller `API::BookingsController`, and splitting on
    # underscores answers `Api::BookingsController` — which raises `NameError`, is rescued, and
    # drops the route silently. Every acronym namespace was invisible.
    def camelize(path)
      return path.camelize if path.respond_to?(:camelize)

      path.split("/").map { |part| part.split("_").map { |word| word[0].to_s.upcase + word[1..].to_s }.join }
          .join("::")
    end

    # `permissions` is the aggregate — its own name and everything it reaches — so an endpoint
    # demands the whole chain behind the operation it names.
    def permissions_of(found)
      found.flat_map(&:permissions).uniq
    end

    def rails_application
      return nil unless defined?(::Rails) && ::Rails.respond_to?(:application)

      ::Rails.application
    end

    # Nameless classes have no permission — a `Class.new` subclass has no constant — and asking
    # one for its name would put `nil` in the graph.
    def operations(*doors)
      doors.flat_map { |door| door.descendants }.select(&:name).uniq
    end

    # A workflow sequences in `call`; an operation that runs before anyone is identified
    # implements `anonymous_call` instead, and its body names steps the same way.
    def entry_point(operation)
      operation.anonymous? ? :anonymous_call : :call
    end
  end
end
