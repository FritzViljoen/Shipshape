# frozen_string_literal: true

# **Which operations exist, and which of them call which — read at boot, from the code.**
#
# The permission model is class-sized: a permission *is* the class name, and a command's door
# is where the actor is checked. An operation reached only from inside another operation is
# therefore never asked for a grant, and listing it on a permissions screen offers an
# administrator a switch that does nothing.
#
# This is what tells the two apart. `grantable` is what a screen should offer; `internal` is
# what it should not.
#
#   Shipshape::CallGraph.edges
#   # => { "CancelBooking" => ["FindBooking", "NotifyCustomer"], "FindBooking" => [] }
#
#   Shipshape::CallGraph.grantable   # => [:CancelBooking]
#   Shipshape::CallGraph.internal    # => [:FindBooking, :NotifyCustomer]
#
# **The keys are class names, and nothing here holds a label.** A permission is its class name
# and a screen wants "Cancel a booking", so the label belongs in a row keyed by the name —
# translated, edited and versioned like any other content, without a deploy.
#
# **The routes are read too, so the answer is per endpoint.** An actor does not hold a
# permission in the abstract; they hold it in order to reach something, and that is the question
# an administrator is really asking:
#
#   Shipshape::CallGraph.routes
#   # => [{ verb: "POST", path: "/bookings/:id/cancel",
#   #       endpoint: "BookingsController#cancel", permissions: [:CancelBooking] }]
#
# **A workflow expands into its steps**, because that is what it demands before its first step
# runs. And a query an action calls is grantable even though a command calls it too, which is
# the whole reason the routes are read rather than the operations alone.
class CallGraph
  FORMAT = /\(\.:format\)\z/.freeze

  class << self
    # `{ "CancelBooking" => ["FindBooking"] }`, for every operation of the given doors.
    def edges(*doors)
      operations(*doors).each_with_object({}) do |operation, found|
        found[operation.name] = Calls.in(operation, entry_point(operation)).map(&:name).uniq.sort
      end
    end

    # Every permission an actor can be asked for: what a route reaches, plus operations nothing
    # else calls — a job's entry point has no route and is still where an actor arrives.
    # Anonymous operations are left out, because they are never granted.
    def grantable(*doors)
      reached = internal_names(*doors)
      roots = operations(*doors).reject { |operation| reached.include?(operation.name) }

      (permissions_of(roots) + routed_permissions).uniq.sort
    end

    # **What each endpoint demands.** Empty when there is no Rails to ask, which is a fact about
    # this process rather than about the application, so it says nothing rather than guessing.
    def routes(application = rails_application)
      return [] unless application

      application.routes.routes.filter_map { |route| endpoint(route) }
    end

    # Reached from another operation and from no endpoint, so under a class-sized permission
    # model no actor needs to hold these: the command's door was the check, and the work inside
    # it is how that one act is done. **A query an action also calls is not on this list**, which
    # is the whole reason the routes are read.
    def internal(*doors)
      reached = internal_names(*doors)
      inner = operations(*doors).select { |operation| reached.include?(operation.name) }

      (permissions_of(inner) - routed_permissions).uniq.sort
    end

    private

    def routed_permissions
      routes.flat_map { |row| row[:permissions] }.uniq
    end

    # A route names its controller and action as strings. The controller may not be loadable,
    # and an action may be inherited or handled by something that is not a class here.
    def endpoint(route)
      controller = controller_for(route)
      action = route.defaults[:action]
      return nil unless controller && action

      demanded = permissions_of(Calls.in(controller, action.to_sym))
      return nil if demanded.empty?

      { verb: route.verb.to_s, path: route.path.spec.to_s.sub(FORMAT, ""),
        endpoint: "#{controller.name}##{action}", permissions: demanded.uniq.sort }
    end

    def controller_for(route)
      name = route.defaults[:controller]
      return nil unless name

      found = Object.const_get("#{name}_controller".split("/").map { |part| camelize(part) }.join("::"))
      found.is_a?(Class) ? found : nil
    rescue ::NameError
      nil
    end

    def camelize(part)
      part.split("_").map { |word| word[0].to_s.upcase + word[1..].to_s }.join
    end

    # **A workflow expands into its steps.** It demands them before its first step runs, so an
    # endpoint that reaches one demands them too.
    def permissions_of(found)
      found.reject(&:anonymous?)
           .flat_map { |op| op.respond_to?(:permissions) ? op.permissions : [op.permission] }
           .uniq
    end

    def rails_application
      return nil unless defined?(::Rails) && ::Rails.respond_to?(:application)

      ::Rails.application
    end

    def internal_names(*doors)
      edges(*doors).values.flatten.uniq
    end

    # Nameless classes have no permission — a `Class.new` subclass has no constant — and asking
    # one for its name would put `nil` in the graph.
    def operations(*doors)
      doors.flat_map { |door| door.descendants }.select(&:name).uniq
    end

    # A workflow sequences in `call`; an operation that runs before anyone is identified
    # implements `anonymous_call` instead, and its body names steps the same way.
    def entry_point(operation)
      operation.anonymous? ? :anonymous_call : :call
    end
  end
end
