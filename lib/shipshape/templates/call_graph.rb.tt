# frozen_string_literal: true

# `edges` / `grantable` / `unchecked` / `leaks` / `routes`. An operation demands its own
# permission and everything it reaches. Keys are class names; a label is content and
# belongs in a row.
class CallGraph
  FORMAT = /\(\.:format\)\z/.freeze

  class << self
    def edges(*doors)
      operations(*doors).each_with_object({}) do |operation, found|
        found[operation.name] = Calls.in(operation, entry_point(operation)).map(&:name).uniq.sort
      end
    end

    def grantable(*doors)
      permissions_of(operations(*doors)).uniq.sort
    end

    def routes(application = rails_application)
      return [] unless application

      application.routes.routes.filter_map { |route| endpoint(route) }
    end

    def unchecked(*doors)
      operations(*doors).select(&:anonymous?).map(&:permission).uniq.sort
    end

    def leaks(*doors)
      operations(*doors).select(&:anonymous?).each_with_object({}) do |operation, found|
        guarded = operation.send(:reaches).reject(&:anonymous?)
        found[operation.name] = guarded.map(&:name).sort if guarded.any?
      end
    end

    private

    def endpoint(route)
      controller = controller_for(route)
      action = route.defaults[:action]
      return nil unless controller && action

      demanded = permissions_of(Calls.in(controller, action.to_sym))

      { verb: route.verb.to_s, path: route.path.spec.to_s.sub(FORMAT, ""),
        endpoint: "#{controller.name}##{action}", permissions: demanded.uniq.sort }
    end

    def controller_for(route)
      name = route.defaults[:controller]
      return nil unless name

      found = Object.const_get(camelize("#{name}_controller"))
      found.is_a?(Class) ? found : nil
    rescue ::NameError
      nil
    end

    def camelize(path)
      return path.camelize if path.respond_to?(:camelize)

      path.split("/").map { |part| part.split("_").map { |word| word[0].to_s.upcase + word[1..].to_s }.join }
          .join("::")
    end

    def permissions_of(found)
      found.flat_map(&:permissions).uniq
    end

    def rails_application
      return nil unless defined?(::Rails) && ::Rails.respond_to?(:application)

      ::Rails.application
    end

    def operations(*doors)
      doors.flat_map { |door| door.descendants }.select(&:name).uniq
    end

    def entry_point(operation)
      operation.anonymous? ? :anonymous_call : :call
    end
  end
end
