# frozen_string_literal: true

# Generated by shipshape. This file is yours now — edit it, and shipshape will not
# overwrite it.
#
# Holds `arguments-are-typed-at-construction`.
#
# It **asserts and never coerces**. A mismatch raises ArgumentError, because it is the
# caller's defect and not an answer anybody is waiting for. Past the guard nothing
# re-checks: a failure at the guard is the caller's, a failure after it is this object's.
#
# There is no macro. Every initializer is written, and `typed(on, Date)` stays a thing you
# can grep for.
module TypedArguments
  private

  def typed(value, type, allow_nil: false)
    return value if allow_nil && value.nil?

    refuse_record(value, type)
    return value if matches?(value, type)

    raise ArgumentError, "expected #{type}, got #{value.class}: #{value.inspect}"
  end

  # **A record is never an argument.** Not into a command, not into a shape, not into
  # anything — a record that travels carries the database with it, and whatever receives it
  # can walk an association, write through it, and reopen a query where nobody is looking
  # for one. What the receiver needs are the fields, or a shape built from them, or the id it
  # should load for itself.
  #
  # Checked here because every generated base class includes this module, so one guard covers
  # every kind at the one moment every argument passes through. It is checked **before** the
  # type match, so `typed(person, PersonRecord)` fails as what it is rather than passing: the
  # declared type being a record is not a licence, it is the clearest statement of the defect.
  def refuse_record(value, type)
    return unless Persistence.anywhere_in?(value)

    raise ArgumentError, "#{value.class} is a record, and a record is not an argument " \
                         "(declared #{type}). Hand over the fields it needs, a shape built " \
                         "from them, or the id to load — never the record."
  end

  def typed_array(values, type, allow_empty: true)
    typed(values, Array)
    raise ArgumentError, "expected a non-empty Array of #{type}" if values.empty? && !allow_empty

    values.each { |value| typed(value, type) }
    values
  end

  # Keys and values are asserted separately, because a Hash whose keys are right and whose
  # values are not is the commoner mistake and the one a bare `Hash` check misses.
  def typed_hash(value, key_type, value_type)
    typed(value, Hash)
    value.each do |key, entry|
      typed(key, key_type)
      typed(entry, value_type)
    end
    value
  end

  # `Boolean` is a name, not a class, so it is known by identity. `nil` is not false and a
  # truthy value is not true — "not supplied" and "supplied as false" are different facts,
  # and a keyword that may be absent says so with `allow_nil:`.
  def matches?(value, type)
    return value == true || value == false if type.equal?(Boolean)

    value.is_a?(type)
  end
end
