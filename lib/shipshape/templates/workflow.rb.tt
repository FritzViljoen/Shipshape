#
# **Sequences operations across several transactions and opens none of its own.** That is a
# saga, and it comes with a bill: every step idempotent, every intermediate state legal, and
# undo written as a further step rather than a rollback — you cannot un-send a confirmation.
#
# It does not branch and does not call a workflow. Its steps are read out of `call` rather
# than declared, so the list cannot disagree with what runs, and only `call` is read —
# `Shipshape/AggregationIsReadable` fails the shapes that reading cannot see.
class Workflow
  include TypedArguments

<%- if auth -%>
  extend Permission

  # **A workflow performs no act**, so it contributes no permission of its own and writes no
  # audit entry: granting `:SettleMonth` does nothing, and each step already records what it
  # did. Memoised at the top of the walk, or every check re-parses the whole closure.
  def self.permissions(seen = [])
    return [] if anonymous?
    return @permissions ||= aggregate_steps([]) if seen.empty?

    seen.include?(self) ? [] : aggregate_steps(seen)
  end

  def self.aggregate_steps(seen)
    onward = seen + [self]
    found = steps
    # **A workflow with no steps is not a workflow.** Answering `[]` would be a fail-open —
    # `[].all?` is true — so it would run for an actor holding no grants at all. An anonymous
    # workflow is unchecked by declaration, so for that one an empty list is the intent.
    raise NotImplementedError, "#{name}#call names no operations to run" if found.empty? && !anonymous?

    found.flat_map { |step| step.permissions(onward) }.uniq
  end
  private_class_method :aggregate_steps

  # Read by `Calls` — the same reader the call graph uses, so a step and an edge are one fact
  # found one way.
  def self.steps
    return @steps if instance_variable_defined?(:@steps)

    @steps = Calls.in(self, anonymous? ? :anonymous_call : :call)
  end


<%- end -%>
<%- if auth -%>
  # A workflow every one of whose steps is anonymous is itself anonymous — a signup
  # sequence runs before anyone is identified — and says so the same way an operation does,
  # by implementing `anonymous_call`.
  def self.call(actor: nil, **arguments)
    return Result.failure(:forbidden) unless permits?(actor)

    operation = new(**arguments)
    result = operation.__perform__(actor)
<%- else -%>
  def self.call(**arguments)
    result = new(**arguments).__perform__
<%- end -%>

<%- if auth -%>
    raise TypeError, "#{name}#call must answer with a Result, got #{result.class}" unless result.is_a?(Result)

    result
  end
<%- else -%>
    raise TypeError, "#{name}#call must answer with a Result, got #{result.class}" unless result.is_a?(Result)

    result
  end
<%- end -%>

  private
<%- if auth -%>

  # Whoever the door was opened for.
  attr_reader :actor

<%- end -%>

  def success(value = nil)
    Result.success(value)
  end

  # A failure carries a value because a refusal often has to be rendered: the request was parsed
  # at the seam and is gone, so a form that did not save comes back as a shape.
  def failure(error, value = nil)
