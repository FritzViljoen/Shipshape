# frozen_string_literal: true

# Sequences operations across several transactions and opens none of its own: every step
# idempotent, every intermediate state legal, undo written as a further step.
# Steps are read out of `call`, so a workflow may only name what `call` names.
class Workflow
  include TypedArguments

<%- if auth -%>
  extend Permission

  def self.permissions(seen = [])
    return [] if anonymous?
    return @permissions ||= aggregate_steps([]) if seen.empty?

    seen.include?(self) ? [] : aggregate_steps(seen)
  end

  def self.aggregate_steps(seen)
    onward = seen + [self]
    found = steps
    raise NotImplementedError, "#{name}#call names no operations to run" if found.empty? && !anonymous?

    found.flat_map { |step| step.permissions(onward) }.uniq
  end
  private_class_method :aggregate_steps

  def self.steps
    return @steps if instance_variable_defined?(:@steps)

    @steps = Calls.in(self, anonymous? ? :anonymous_call : :call)
  end

<%- end -%>
<%- if auth -%>
  def self.call(actor: nil, **arguments)
    return Result.failure(:forbidden) unless permits?(actor)

    operation = new(**arguments)
    result = operation.__perform__(actor)
<%- else -%>
  def self.call(**arguments)
    result = new(**arguments).__perform__
<%- end -%>

<%- if auth -%>
    raise TypeError, "#{name}#call must answer with a Result, got #{result.class}" unless result.is_a?(Result)

    result
  end
<%- else -%>
    raise TypeError, "#{name}#call must answer with a Result, got #{result.class}" unless result.is_a?(Result)

    result
  end
<%- end -%>

  private
<%- if auth -%>

  attr_reader :actor

<%- end -%>

  def success(value = nil)
    Result.success(value)
  end

  def failure(error, value = nil)
    Result.failure(error, value)
  end

<%- if auth -%>
  public def __perform__(actor)
    @actor = actor

    self.class.anonymous? ? anonymous_call : call
  end
<%- else -%>
  public def __perform__
    call
  end
<%- end -%>

  private_class_method :new, :allocate
end
