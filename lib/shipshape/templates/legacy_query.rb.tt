# buys is that the number is knowable at all: every door is one named piece of the old
# world still standing.
class LegacyQuery
  include TypedArguments

<%- if auth -%>
  extend Permission
<%- end -%>

  # A query has no Result to carry a refusal, and wrapping one would make every caller
  # unwrap a value that was never in doubt. So it raises, like every other query failure.
  #
  # An operation implementing `anonymous_call` instead of `call` runs before anyone is
  # identified and is not checked. That is a property of the class, never of the caller.
<%- if auth -%>
  def self.call(actor: nil, **arguments)
