    # symbol is not the generated dispatch `code-is-written-not-generated` forbids — it
    # names one of two methods, and both are greppable.
    answer = operation.send(anonymous? ? :anonymous_call : :call)
<%- else -%>
  def self.call(**arguments)
    answer = new(**arguments).send(:call)
<%- end -%>

    raise TypeError, "#{name}#call must answer with shapes, got #{answer.class}" unless shapes?(answer)

    answer
  end

  def self.shapes?(answer)
    return answer.all? { |entry| entry.is_a?(Shape) } if answer.is_a?(Array)

    answer.is_a?(Shape)
