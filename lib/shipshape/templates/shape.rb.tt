# frozen_string_literal: true

# It holds other shapes rather than copying their fields, and computes nothing.
class Shape
  include TypedArguments

  extend HoldsNoRecords

  def ==(other)
    other.class == self.class && other.state == state
  end

  alias eql? ==

  def hash
    ([self.class] + state).hash
  end

  def inspect
    pairs = instance_variables.map { |name| "#{name.to_s.delete("@")}: #{instance_variable_get(name).inspect}" }

    "#<#{self.class.name} #{pairs.join(", ")}>"
  end

  def to_h
    instance_variables.to_h { |name| [name.to_s.delete("@").to_sym, instance_variable_get(name)] }
  end

  protected

  def state
    instance_variables.sort.map { |name| instance_variable_get(name) }
  end
end
