# mixed in — there is nothing to infer and no name to guess.
module OperationSurface
  # The two an operation may answer. Which of them it implements is what decides whether it
  # is checked, so both are expected here and neither is a surprise.
  ENTRY = %i[call anonymous_call].freeze

  # Every public method this operation has that its base class does not — instance and
  # class, mixins included, however they arrived.
  #
  # **Measured from the door, not from `superclass`.** They are the same class while
  # `an-operation-is-a-leaf` holds, and if it ever does not, measuring from `superclass`
  # would quietly compare an operation against another operation and report nothing. A guard
  # that goes silent exactly when a second law breaks is worse than no guard.
  def self.public_additions(operation, doors)
    door = doors.find { |candidate| operation < candidate }
