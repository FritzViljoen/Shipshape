# frozen_string_literal: true

require "test_helper"

# Generated by shipshape. This file is yours now.
#
# **The inventory, checked against the database rather than against the schema file.**
#
# `Shipshape/PersonalDataIsDeclared` reads `db/schema.rb`, which is what this repository's
# migrations produced. This asks the connection, which is what actually exists — a column
# added by a hand-run statement, a vendored migration or another service sharing the database
# is invisible to the first and present here.
#
# It also asks the question the cop cannot: **is every route actually reachable?** A column
# marked `:anonymise` with nothing that anonymises it is a declaration, not a capability, and
# a declaration is exactly what an erasure request cannot be answered with.
class PersonalDataIsErasableTest < ActiveSupport::TestCase
  # Columns whose name suggests a person. Kept in step with the cop's list by the test below,
  # so the two cannot drift apart and disagree about what needs classifying.
  SUGGESTS_A_PERSON = /
    \b(email|phone|mobile|telephone|address|postcode|zipcode|ip_address|
       first_name|last_name|full_name|surname|forename|maiden|
       date_of_birth|dob|birth_date|passport|national_id|ssn|nino|tax_id|
       latitude|longitude|gender|nationality|signature|avatar|photo)\b
  /x

  def test_every_column_the_database_holds_is_classified
    unclassified = live_columns.reject do |table, column|
      PersonalData.declared?(table, column)
    end

    assert_equal [], unclassified.map { |t, c| "#{t}.#{c}" }.sort, <<~WHY
      These columns exist in the database and are not in PersonalData::COLUMNS.

      Each one is a decision somebody has to make once: does it hold something about a
      person, and what happens to it when that person asks to be forgotten? Four answers are
      available and `:not_personal` is one of them — say so and the question stops being
      asked.

      A column nobody has classified is a column nobody will remember during an erasure.
    WHY
  end

  # A declaration is not a capability.
  def test_every_route_is_one_the_registry_knows
    unknown = PersonalData::COLUMNS.flat_map do |table, columns|
      columns.reject { |_, route| PersonalData::ROUTES.include?(route) }
             .map { |column, route| "#{table}.#{column} => #{route.inspect}" }
    end

    assert_equal [], unknown.sort
  end

  # The registry names tables; the database has to have them, or the entry is about something
  # that no longer exists and the erasure command written from it will miss a table that does.
  def test_every_declared_table_still_exists
    missing = PersonalData::COLUMNS.keys.reject { |table| connection.table_exists?(table) }

    assert_equal [], missing.sort,
                 "PersonalData names tables the database does not have. A stale inventory " \
                 "reads as coverage."
  end

  def test_every_declared_column_still_exists
    missing = PersonalData::COLUMNS.flat_map do |table, columns|
      next [] unless connection.table_exists?(table)

      present = connection.columns(table).map(&:name)
      (columns.keys - present).map { |column| "#{table}.#{column}" }
    end

    assert_equal [], missing.sort
  end

  private

  def connection
    ActiveRecord::Base.connection
  end

  def live_columns
    connection.tables.flat_map do |table|
      connection.columns(table).map(&:name)
                .select { |column| SUGGESTS_A_PERSON.match?(column) }
                .map { |column| [table, column] }
    end
  end
end
