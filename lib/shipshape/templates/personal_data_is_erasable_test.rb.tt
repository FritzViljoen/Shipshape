# frozen_string_literal: true

require "test_helper"

# Read from the schema, so a new column fails this until it is classified. It proves the
# inventory is complete, never that an erasure is correct.
class PersonalDataIsErasableTest < ActiveSupport::TestCase
  NAMES = %w[
    email phone mobile telephone address postcode zipcode ip_address
    first_name last_name full_name surname forename maiden_name
    date_of_birth dob birth_date passport national_id ssn nino tax_id
    latitude longitude gender nationality signature avatar photo
  ].freeze

  def self.suggests_a_person?(column)
    NAMES.any? { |name| column == name || column.end_with?("_#{name}") }
  end

  def test_every_column_the_database_holds_is_classified
    unclassified = live_columns.reject do |table, column|
      PersonalData.declared?(table, column)
    end

    assert_equal [], unclassified.map { |t, c| "#{t}.#{c}" }.sort, <<~WHY
      These columns exist in the database and are not in PersonalData::COLUMNS.

      Each one is a decision somebody has to make once: does it hold something about a
      person, and what happens to it when that person asks to be forgotten? Four answers are
      available and `:not_personal` is one of them — say so and the question stops being
      asked.

      A column nobody has classified is a column nobody will remember during an erasure.
    WHY
  end

  def test_every_route_is_one_the_registry_knows
    unknown = PersonalData::COLUMNS.flat_map do |table, columns|
      columns.reject { |_, route| PersonalData::ROUTES.include?(route) }
             .map { |column, route| "#{table}.#{column} => #{route.inspect}" }
    end

    assert_equal [], unknown.sort
  end

  def test_every_declared_table_still_exists
    missing = PersonalData::COLUMNS.keys.reject { |table| connection.table_exists?(table) }

    assert_equal [], missing.sort,
                 "PersonalData names tables the database does not have. A stale inventory " \
                 "reads as coverage."
  end

  def test_every_declared_column_still_exists
    missing = PersonalData::COLUMNS.flat_map do |table, columns|
      next [] unless connection.table_exists?(table)

      present = connection.columns(table).map(&:name)
      (columns.keys - present).map { |column| "#{table}.#{column}" }
    end

    assert_equal [], missing.sort
  end

  private

  def connection
    ActiveRecord::Base.connection
  end

  def live_columns
    connection.tables.flat_map do |table|
      connection.columns(table).reject { |column| column.type == :boolean }.map(&:name)
                .select { |column| self.class.suggests_a_person?(column) }
                .map { |column| [table, column] }
    end
  end
end
