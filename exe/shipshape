#!/usr/bin/env ruby
# frozen_string_literal: true

require "shipshape"
require "json"
require "shipshape/install"
require "shipshape/rules"
require "shipshape/canaries"
require "shipshape/coverage"
require "shipshape/queue"
require "shipshape/wire_typed_params"
require "shipshape/check"
require "shipshape/report"
require "shipshape/report_as_markdown"

WIRING = {
  wired: "  wired    %<path>s — includes TypedParams",
  already: "  kept     %<path>s — already includes TypedParams",
  no_controller: "  MISSING  %<path>s — nothing includes TypedParams, so nothing is parsed at the seam",
}.freeze

# Authorisation is opt-in because this gem installs into codebases that already run. Base
# classes demanding an actor on day one would stop every call site at once, which is an
# outage rather than a migration.
AUTH_OFF = <<~TEXT
  Authorisation is OFF. `shipshape install --auth` writes the same base classes with a
  permission check in every door, and adds app/shipshape/permission.rb. Turn it on when
  the seam is ready; existing files are never overwritten, so you will be shown a diff to
  apply rather than having yours replaced.
TEXT

AUTH_ON = <<~TEXT
  Authorisation is ON. Every operation now needs `actor:`, and its permission is its class
  name. An operation that runs before anyone is identified says so by implementing
  `anonymous_call` instead of `call`.
TEXT

def install(auth)
  report = Shipshape::Install.new(root: Dir.pwd, auth: auth).call

  report[:written].each { |path| puts "  written  #{path}" }
  report[:skipped].each { |path| puts "  kept     #{path}" }

  outcome, path = Shipshape::WireTypedParams.new(root: Dir.pwd).call
  puts format(WIRING.fetch(outcome), path: path)

  puts
  puts "#{report[:written].length} written, #{report[:skipped].length} already yours."
  puts "Nothing is overwritten. Point Shipshape/CallGraph's BaseClasses at these names."
  puts auth ? AUTH_ON : AUTH_OFF
  outcome == :no_controller ? 1 : 0
end

# The rules file an agent is handed. Derived from the application's own configuration and
# from the cop registry, so it cannot fall behind the code — regenerate it, never edit it.
def rules
  store = RuboCop::ConfigStore.new
  target = ARGV.include?("--out") ? ARGV[ARGV.index("--out") + 1] : "CLAUDE.md"

  if File.exist?(target) && !ARGV.include?("--force")
    warn "shipshape: #{target} exists. It is generated — regenerate with --force, or pass"
    warn "--out to write elsewhere. Nothing has been changed."
    return 1
  end

  File.write(target, Shipshape::Rules.new(config: store.for_pwd, root: Dir.pwd).call)
  puts "  written  #{target}"
  puts
  puts "Regenerate rather than edit. Everything in it is derived from .rubocop.yml and the"
  puts "cops that are loaded, so an edit is a second copy of a fact and it will go stale."
  0
end

# A guard that does not run reports the same thing as a guard that finds nothing. This plants
# one known violation per cop, under this application's own paths, and fails on any cop that
# stayed silent.
def canaries
  root = ARGV.include?("--dir") ? ARGV[ARGV.index("--dir") + 1] : Shipshape::Canaries::DIRECTORY
  canaries = Shipshape::Canaries.new(config: RuboCop::ConfigStore.new.for_pwd, root: root)

  if ARGV.include?("--plant")
    begin
      planted = canaries.plant
    rescue Shipshape::Error => e
      warn e.message
      warn "Delete the directory and plant again, or point --dir somewhere empty."
      return 1
    end

    puts "  written  #{root}/ — #{planted} canaries and their .rubocop.yml"
    puts
    puts "Check this directory in, and exclude it from your ordinary lint run: every file"
    puts "in it is a deliberate violation. Then run `shipshape canaries` in CI."
    return 0
  end

  unless Dir.exist?(root)
    warn "shipshape: no canaries at #{root}. Plant them with `shipshape canaries --plant`."
    return 1
  end

  result = canaries.call
  puts "  #{result.fired.length} cops caught their planted violation."
  result.unplanted.each { |cop| puts "  no canary  #{cop}" }
  result.silent.each { |cop| puts "  SILENT     #{cop}" }

  if result.ok?
    puts
    puts "Every guard is running."
    return 0
  end

  puts
  puts "A cop that cannot find a violation written for it is protecting nothing. Usually the"
  puts "kind's paths in Shipshape/CallGraph do not match where this repository keeps them."
  1
end

# A file that resolves to no kind is skipped by every kind-scoped cop, silently and
# indistinguishably from a file they approved of. A clean run means nothing until you know
# how much of the tree was inspected at all.
def coverage
  result = Shipshape::Coverage.new(config: RuboCop::ConfigStore.new.for_pwd, root: Dir.pwd).call

  puts "  #{result.governed} of #{result.total} files resolve to a kind (#{result.percentage}%)."
  result.by_kind.each { |kind, n| puts format("    %-18s %5d", kind, n) }

  if result.ungoverned.any?
    puts
    puts "  Reached by no kind-scoped cop:"
    result.ungoverned.first(10).each { |path| puts "    #{path}" }
    puts "    …and #{result.ungoverned.length - 10} more" if result.ungoverned.length > 10
  end

  puts
  if result.percentage >= 90
    puts "Nearly everything is governed."
  else
    puts "Add the trees this repository actually uses to Shipshape/CallGraph's Kinds. An"
    puts "engine monorepo keeping code at core/app/models needs that path declared, or every"
    puts "kind-scoped cop reads it as clean without opening it."
  end
  0
end

# The work, one file at a time. An agent handed a whole codebase does the wrong thing; it
# needs one file, the rules it breaks, and a way to know it finished.
def next_work
  count = ARGV.include?("--count") ? ARGV[ARGV.index("--count") + 1].to_i : 3
  units = Shipshape::Queue.new(root: Dir.pwd).call(limit: count)

  return puts("Nothing left. Every file this configuration reaches is clean.") || 0 if units.empty?

  return puts(JSON.pretty_generate(units.map(&:to_h))) || 0 if ARGV.include?("--json")

  units.each_with_index do |unit, index|
    puts "── #{index + 1}. #{unit.path}"
    puts "   breaks #{unit.cops.length} rules, #{unit.offences.length} times"
    puts(unit.tested ? "   a test names this file — safe to change first" : "   NO TEST NAMES THIS FILE")
    puts
    unit.offences.first(3).each do |offence|
      puts "   #{unit.path}:#{offence[:line]}  #{offence[:cop]}"
      offence[:message].lines.each { |line| puts "     #{line.chomp}" }
      puts
    end
    remaining = unit.offences.length - 3
    puts "   …and #{remaining} more offences in this file\n\n" if remaining.positive?
  end

  puts "The order matters: reads apart from writes, then thread out the ambient reads, then"
  puts "move the data pretending to be code, and only then split. docs/decomposing/"
  puts
  puts "Do one. Then `shipshape check` — the count must fall, and your tests must still pass."
  puts "Nothing here proves behaviour is preserved. That is the tests' job, and it is why the"
  puts "covered files are offered first."
  0
end

def check(trunk)
  report = Shipshape::Check.new(root: Dir.pwd, trunk: trunk).call

  puts "baseline #{report[:sha][0, 12]} (merge-base with #{report[:trunk]})"
  puts

  report[:fallen].each { |cop, row| puts "  fell     #{cop}  #{row[:was]} -> #{row[:now]}" }
  report[:risen].each { |cop, row| puts "  ROSE     #{cop}  #{row[:was]} -> #{row[:now]}" }

  return report_clean(report) if report[:risen].empty?

  puts
  puts "#{report[:risen].length} cop(s) found more than the baseline. The count may fall, never rise."
  1
end

def report_clean(report)
  total = report[:head].values.sum

  puts "  held     nothing rose"
  puts
  puts "#{total} offence(s) remain, and that is the new floor."
  0
end

def report
  answer = Shipshape::Report.new(root: Dir.pwd).call
  puts Shipshape::ReportAsMarkdown.new(report: answer).call
  0
end

command = ARGV.shift

case command
when "install" then exit install(ARGV.include?("--auth"))
when "rules" then exit rules
when "canaries" then exit canaries
when "coverage" then exit coverage
when "next" then exit next_work
when "report" then exit report
when "check" then exit check(ARGV.include?("--trunk") ? ARGV[ARGV.index("--trunk") + 1] : nil)
when "version", "--version", "-v" then puts Shipshape::VERSION
else
  warn "usage: shipshape install [--auth] | rules | canaries [--plant] | coverage | next | check | report | version"
  warn "       shipshape report"
  warn "       shipshape check [--trunk <ref>]"
  warn "       shipshape version"
  exit 1
end
