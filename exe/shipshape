#!/usr/bin/env ruby
# frozen_string_literal: true

require "shipshape"
require "json"
require "shipshape/install"
require "shipshape/rules"
require "shipshape/canaries"
require "shipshape/coverage"
require "shipshape/queue"
require "shipshape/wire_typed_params"
require "shipshape/check"
require "shipshape/report"
require "shipshape/report_as_markdown"

WIRING = {
  wired: "  wired    %<path>s — includes TypedParams",
  already: "  kept     %<path>s — already includes TypedParams",
  no_controller: "  MISSING  %<path>s — nothing includes TypedParams, so nothing is parsed at the seam",
}.freeze

# Opt-in: base classes demanding an actor on day one stop every call site at once.
AUTH_OFF = <<~TEXT
  Authorisation is OFF. `shipshape install --auth` writes the same base classes with a
  permission check in every door, and adds app/shipshape/permission.rb. Turn it on when
  the seam is ready; existing files are never overwritten, so a file that would change
  lands beside yours as `.new` rather than having yours replaced.
TEXT

# The one generated file that can stop a boot: it inherits from the `view_component` gem.
VIEW_COMPONENTS_OFF = <<~TEXT

  View components are OFF. `shipshape install --view-components` adds
  app/shipshape/application_view_component.rb, which refuses to hold a record exactly as the
  generated Shape does. It inherits from the view_component gem, so it is only written when
  you ask for it.
TEXT

AUTH_ON = <<~TEXT
  Authorisation is ON. Every operation now needs `actor:`, and its permission is its class
  name. An operation that runs before anyone is identified says so by implementing
  `anonymous_call` instead of `call`.
TEXT

def install(auth, view_components)
  report = Shipshape::Install.new(root: Dir.pwd, auth: auth, view_components: view_components).call

  report[:written].each { |path| puts "  written  #{path}" }
  report[:skipped].each { |path| puts "  kept     #{path}" }
  report[:diverged].each { |path| puts "  DIFFERS  #{path} — wrote #{path}.new to compare against" }
  report[:stale].each { |path| puts "  STALE    #{path}.new — #{path} matches this run again; remove the .new yourself" }

  outcome, path = Shipshape::WireTypedParams.new(root: Dir.pwd).call
  puts format(WIRING.fetch(outcome), path: path)

  puts
  puts "#{report[:written].length} written, #{report[:skipped].length} already yours."
  if report[:diverged].any?
    puts "#{report[:diverged].length} differ from what this run would write, with auth: #{auth}" \
         " and view-components: #{view_components} — diff each against its own .new file yourself;"
    puts "a diff run here would mix your edits into the gem's changes. If those are not the flags"
    puts "you meant to install with, that is the likely reason, not a template that moved on."
  end
  if report[:stale].any?
    puts "#{report[:stale].length} .new file(s) are left from an earlier divergence that this run"
    puts "no longer sees; nothing here deletes them."
  end
  puts "Nothing is overwritten. Point Shipshape/CallGraph's BaseClasses at these names."
  puts auth ? AUTH_ON : AUTH_OFF
  puts VIEW_COMPONENTS_OFF unless view_components
  outcome == :no_controller ? 1 : 0
end

# The rules file an agent is handed. Derived from the application's own configuration and
# from the cop registry, so it cannot fall behind the code — regenerate it, never edit it.
def rules
  store = RuboCop::ConfigStore.new
  target = option("out", "CLAUDE.md")

  if File.exist?(target) && !ARGV.include?("--force")
    warn "shipshape: #{target} exists. It is generated — regenerate with --force, or pass"
    warn "--out to write elsewhere. Nothing has been changed."
    return 1
  end

  File.write(target, Shipshape::Rules.new(config: store.for_pwd, root: Dir.pwd).call)
  puts "  written  #{target}"
  puts
  puts "Regenerate rather than edit. Everything in it is derived from .rubocop.yml and the"
  puts "cops that are loaded, so an edit is a second copy of a fact and it will go stale."
  0
end

# One known violation per cop, under this application's own paths: a guard that does not run
# reports the same thing as a guard that finds nothing.
def canaries
  root = option("dir", Shipshape::Canaries::DIRECTORY)
  canaries = Shipshape::Canaries.new(config: RuboCop::ConfigStore.new.for_pwd, root: root)

  if ARGV.include?("--plant")
    begin
      planted = canaries.plant
    rescue Shipshape::Error => e
      warn e.message
      warn "Delete the directory and plant again, or point --dir somewhere empty."
      return 1
    end

    puts "  written  #{root}/ — #{planted} canaries and their .rubocop.yml"
    puts
    puts "Check this directory in, and exclude it from your ordinary lint run: every file"
    puts "in it is a deliberate violation. Then run `shipshape canaries` in CI."
    return 0
  end

  unless Dir.exist?(root)
    warn "shipshape: no canaries at #{root}. Plant them with `shipshape canaries --plant`."
    return 1
  end

  result = canaries.call
  puts "  #{result.fired.length} cops caught their planted violation."
  result.unplanted.each { |cop| puts "  no canary  #{cop}" }
  result.silent.each { |cop| puts "  SILENT     #{cop}" }

  if result.ok?
    puts
    puts "Every guard is running."
    return 0
  end

  puts
  puts "A cop that cannot find a violation written for it is protecting nothing. Usually the"
  puts "kind's paths in Shipshape/CallGraph do not match where this repository keeps them."
  1
end

# An application's own `.rubocop.yml` may be unloadable here: it `require:`s plugins pinned to
# RuboCop 0.x, which cannot be activated beside the 1.x this gem needs, and the run dies in
# config loading before a file is read. `--config` is the way out.
def config_store
  store = RuboCop::ConfigStore.new
  path = option("config")
  store.options_config = path if path
  store
end

def chosen_config
  option("config")
end

# Both spellings: `--config=path` was ignored in silence, and the run then measured with the
# application's own config and said nothing about it.
def option(name, default = nil)
  flag = "--#{name}"
  joined = ARGV.find { |argument| argument.start_with?("#{flag}=") }
  if joined
    value = joined.split("=", 2).last
    if value.empty?
      raise Shipshape::Error, "shipshape: #{flag}= has nothing after the \"=\". Write \"#{flag}=<value>\"."
    end

    return value
  end

  index = ARGV.index(flag)
  return default unless index

  value = ARGV[index + 1]
  if value.nil? || value.start_with?("--")
    raise Shipshape::Error, "shipshape: #{flag} was the last thing on the line, or the next " \
                             "word is another flag. Write \"#{flag} <value>\", with the value " \
                             "right after it."
  end

  value
end

# A file that resolves to no kind is skipped by every kind-scoped cop, silently and
# indistinguishably from a file they approved of. A clean run means nothing until you know
# how much of the tree was inspected at all.
def coverage
  result = Shipshape::Coverage.new(config: config_store.for_pwd, root: Dir.pwd).call

  puts "  #{result.governed} of #{result.total} files resolve to a kind (#{result.percentage}%)."
  result.by_kind.each { |kind, n| puts format("    %-18s %5d", kind, n) }

  if result.ungoverned.any?
    puts
    puts "  Reached by no kind-scoped cop:"
    result.ungoverned.first(10).each { |path| puts "    #{path}" }
    puts "    …and #{result.ungoverned.length - 10} more" if result.ungoverned.length > 10
  end

  puts
  if result.percentage >= 90
    puts "Nearly everything is governed."
  else
    puts "Add the trees this repository actually uses to Shipshape/CallGraph's Kinds. An"
    puts "engine monorepo keeping code at core/app/models needs that path declared, or every"
    puts "kind-scoped cop reads it as clean without opening it."
  end
  0
end

# The work, one file at a time. Every procedure changes internals, so the edge is the only
# place a characterisation test is worth writing before anything moves.
def edges
  settings = Shipshape::Settings.layout(config_store.for_pwd)
  report = Shipshape::Edges.new(root: Dir.pwd, settings: settings).call

  if report.edges.empty?
    warn "No edges found. Declare request_handling or entry_point paths in Shipshape/CallGraph's"
    warn "Kinds — until a tree is declared, nothing looks at it and this reports a clean zero."
    return 1
  end

  return puts(JSON.pretty_generate(report.uncovered.map(&:to_h))) || 0 if ARGV.include?("--json")

  puts "#{report.edges.length} edges, #{report.actions} actions."

  if report.covered.empty? && !report.edges.empty?
    warn "No edge is named anywhere in test/ or spec/. Check the suite is where this expects"
    warn "it — a repository that keeps tests per engine reads as entirely untested otherwise."
  end
  puts

  if report.ready?
    puts "Every edge is named by something in the suite."
    puts "That is not proof they are characterised — only that a test mentions each one."
    return 0
  end

  puts "NOT NAMED BY ANY TEST — characterise these before moving anything behind them:"
  report.uncovered.each do |edge|
    puts format("  %-52s %s", edge.file, edge.actions.join(", "))
  end
  puts
  puts "#{report.covered.length} of #{report.edges.length} edges are named somewhere in the suite."
  puts "A refactor changes what is behind an edge, never what the edge answers — so a test"
  puts "here survives the work, and a test on an internal moves with it and proves nothing."
  0
end

def next_work
  count = option("count", "3").to_i
  units = Shipshape::Queue.new(root: Dir.pwd).call(limit: count)

  return puts("Nothing left. Every file this configuration reaches is clean.") || 0 if units.empty?

  return puts(JSON.pretty_generate(units.map(&:to_h))) || 0 if ARGV.include?("--json")

  units.each_with_index do |unit, index|
    puts "── #{index + 1}. #{unit.path}"
    puts "   breaks #{unit.cops.length} rules, #{unit.offences.length} times"
    if unit.methods.zero?
      puts "   no methods to move"
    elsif unit.unnamed.empty?
      puts "   all #{unit.methods} methods are named in tests — safest to start here"
    else
      puts "   #{unit.covered} of #{unit.methods} methods named in tests"
      puts "   NOT NAMED BY ANY TEST: #{unit.unnamed.first(6).join(', ')}#{unit.unnamed.length > 6 ? ', …' : ''}"
      puts "   extract the covered ones first; nothing here proves behaviour is preserved"
    end
    puts
    unit.offences.first(3).each do |offence|
      puts "   #{unit.path}:#{offence[:line]}  #{offence[:cop]}"
      offence[:message].lines.each { |line| puts "     #{line.chomp}" }
      puts
    end
    remaining = unit.offences.length - 3
    puts "   …and #{remaining} more offences in this file\n\n" if remaining.positive?
  end

  puts "The order matters: reads apart from writes, then thread out the ambient reads, then"
  puts "move the data pretending to be code, and only then split. docs/decomposing/"
  puts
  puts "Do one. Then `shipshape check` — the count must fall, and your tests must still pass."
  puts "Nothing here proves behaviour is preserved. That is the tests' job, and it is why the"
  puts "covered files are offered first."
  0
end

def check(trunk)
  report = Shipshape::Check.new(root: Dir.pwd, trunk: trunk, config: chosen_config).call

  puts "baseline #{report[:sha][0, 12]} (merge-base with #{report[:trunk]})"
  puts

  if report[:off].any?
    report[:off].each { |cop| puts "  OFF      #{cop} — disabled, so nothing here is measured" }
    puts
  end

  report[:fallen].each { |cop, row| puts "  fell     #{cop}  #{row[:was]} -> #{row[:now]}" }
  report[:risen].each { |cop, row| puts "  ROSE     #{cop}  #{row[:was]} -> #{row[:now]}" }
  report[:retiring].each do |kind, row|
    puts "  ARRIVED  #{kind}  #{row[:was]} -> #{row[:now]} files — that kind is on its way out"
  end

  clean = report[:risen].empty? && report[:retiring].empty?
  return report_clean(report) if clean

  puts
  if report[:risen].any?
    puts "#{report[:risen].length} cop(s) found more than the baseline. The count may fall, never rise."
  end
  if report[:retiring].any?
    puts "Code arrived in a kind that is on its way out. It is a waypoint, not a destination."
  end
  1
end

def report_clean(report)
  total = report[:head].values.sum
  off = report[:off]

  puts "  held     nothing rose"
  puts
  line = "#{total} offence(s) remain, and that is the new floor."
  line += " #{off.length} guard(s) are off; their code is unmeasured." if off.any?
  puts line
  0
end

def report
  answer = Shipshape::Report.new(root: Dir.pwd).call
  puts Shipshape::ReportAsMarkdown.new(report: answer).call
  0
end

command = ARGV.shift

begin
case command
when "install" then exit install(ARGV.include?("--auth"), ARGV.include?("--view-components"))
when "rules" then exit rules
when "canaries" then exit canaries
when "coverage" then exit coverage
when "edges" then exit edges
when "next" then exit next_work
when "report" then exit report
when "check" then exit check(option("trunk"))
when "version", "--version", "-v" then puts Shipshape::VERSION
else
  warn "usage: shipshape install [--auth] [--view-components] | rules | canaries [--plant]"
  warn "       shipshape coverage [--config <path>] | edges [--config <path>] | next | report"
  warn "       shipshape check [--trunk <ref>] [--config <path>]"
  warn "       shipshape version"
  exit 1
end
# Messages, not backtraces: a stack trace buries the sentence that says what to do.
rescue Shipshape::Error => e
  warn e.message
  exit 1
end
